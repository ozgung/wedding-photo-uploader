# Copy to .env. Keep UPLOADS_ENABLED=false until real phone and Drive checks pass.

# --- Your event ---
EVENT_TITLE=Alex & Sam
EVENT_MONOGRAM=A&S
# ISO date; each language formats it for guests.
EVENT_DATE=2027-06-12
# Uploads close at this instant (timezone offset required). Guests see the day before as the last day.
CLOSE_AT=2027-06-20T00:00:00+00:00
# Guests get their browser language when available, otherwise DEFAULT_LANG.
DEFAULT_LANG=en
LANGUAGES=en,tr,de,es,fr,it
# Optional readable path for printed cards, e.g. https://photos.example.com/alex-sam-120627
EVENT_SLUG=
# Optional; shown to guests when set.
CONTACT_EMAIL=
PRIVACY_URL=
# Optional; defaults to "EVENT_TITLE · EVENT_DATE" and "Guest".
DRIVE_FOLDER_NAME=
ANONYMOUS_GUEST_LABEL=Guest

# --- Server ---
PUBLIC_ORIGIN=https://photos.example.com
DEV_MODE=false
UPLOADS_ENABLED=false
DATA_DIR=data
VALIDATOR_SOCKET=/run/wedding-validator/submit.sock
TEMP_BUDGET_BYTES=3000000000
MIN_FREE_BYTES=2000000000
EVENT_BUDGET_BYTES=100000000000

# --- Credentials (filled in by the setup commands; never commit) ---
INVITE_HASH=
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
GOOGLE_TOKEN_FILE=secrets/google-token.json
DRIVE_ROOT_ID=
